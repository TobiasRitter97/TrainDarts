# Firebase-Zugangsdaten fuer das Frontend.
#
# Diese Datei ist die VORLAGE und gehoert ins Repo. Die echten Werte
# kommen in eine Datei namens ".env" daneben - die ist in .gitignore
# eingetragen und wird nie eingecheckt.
#
# Alle Werte stehen in der Firebase Console unter:
#   Projekt-Einstellungen -> Allgemein -> Meine Apps -> Web-App -> SDK-Konfiguration
#
# Hinweis: der Web-API-Key ist KEIN Geheimnis. Firebase-Web-Keys sind
# oeffentlich sichtbar, die eigentliche Absicherung passiert ueber die
# Firestore-Sicherheitsregeln (nur der eigene users/{uid}-Pfad ist
# les- und schreibbar). Die Verlagerung hierher ist Aufraeumarbeit,
# damit projektspezifische Werte nicht im Quelltext stehen.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Nur fuer den Online-Multiplayer (Realtime Database). Die Datenbank
# liegt in europe-west1; ohne diese URL raet das SDK die falsche
# US-Region und Schreibzugriffe haengen unbemerkt.
VITE_FIREBASE_DATABASE_URL=
